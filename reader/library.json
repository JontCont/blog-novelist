    {
      "slug": "midnight-knock",
      "title": "午夜的第三聲敲門",
      "genre": "恐怖靈異",
      "publishedAt": "2026-10-24",
      "cover": "https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=720&q=85",
      "description": "搬進新公寓的陳雨，連續聽見深夜敲門聲。她與母親追查消失的 03 號房，逐步揭開一段被遺忘的等待。",
      "details": {
        "about": "陳雨搬進一間空了多年的公寓後，夜裡總有人敲門。當聲音從門外轉到衣櫃裡，她和母親開始追查消失的 03 號房，以及一名被遺忘的孩子。",
        "characters": [
          {
            "name": "陳雨",
            "role": "主角",
            "description": "剛搬進新公寓的年輕女子。她試著用理性解釋怪事，最後選擇正面回應那個一直等待的孩子。"
          },
          {
            "name": "媽媽",
            "role": "陳雨的母親",
            "description": "住在外縣市。她與消失的房間有一段不願回想的過去，也一直保護著女兒。"
          },
          {
            "name": "小安",
            "role": "房間裡的孩子",
            "description": "留在 03 號房的靈異存在。她以敲門和電話尋找家人，真正想要的是有人記得她。"
          },
          {
            "name": "老周",
            "role": "前管理員",
            "description": "知道舊房客失聯的管理員。他的身分與出現時間，直到最後才顯出異樣。"
          }
        ],
        "timeline": [
          { "chapter": 1, "period": "搬入首夜至第三夜", "event": "門外傳來母親的聲音，敲門聲最後從衣櫃裡響起。" },
          { "chapter": 2, "period": "第三夜稍後", "event": "老周陪陳雨回房，手機與衣櫃出現新的異狀。" },
          { "chapter": 3, "period": "同一個夜晚", "event": "陳雨遇見自己的影子，逃出公寓並與母親離開。" },
          { "chapter": 4, "period": "幾天後", "event": "一通來自已停用號碼的來電，讓陳雨和母親重查舊事。" },
          { "chapter": 5, "period": "白天", "event": "大樓檔案揭露消失的 03 號房與林姓房客。" },
          { "chapter": 6, "period": "同日", "event": "舊房客的敲門習慣，竟與陳雨童年的暗號相同。" },
          { "chapter": 7, "period": "返家途中", "event": "母親提起夭折的孩子與反覆出現的夢。" },
          { "chapter": 8, "period": "當晚", "event": "母女在車裡收到訊息，決定回去把話說清楚。" },
          { "chapter": 9, "period": "隔日黃昏", "event": "電梯帶她們前往不存在的 03 號房。" },
          { "chapter": 10, "period": "黃昏之後", "event": "房間裡浮現母女舊照，無電的電話自行響起。" },
          { "chapter": 11, "period": "同一夜", "event": "母女見到等待多年的孩子，孩子請她們留下。" },
          { "chapter": 12, "period": "深夜", "event": "陳雨敲門回應孩子，母女趁走廊恢復原樣時離開。" },
          { "chapter": 13, "period": "天亮", "event": "老周已退休多年的真相浮現，母女交出舊檔案。" },
          { "chapter": 14, "period": "幾個月後", "event": "陳雨和母親搬進新家，開始談起那個孩子。" },
          { "chapter": 15, "period": "新家的一夜", "event": "抽屜裡傳來敲聲，母女聽見熟悉的回應。" }
        ]
      },
