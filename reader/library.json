    {
      "slug": "room-4104",
      "title": "4104套房",
      "genre": "心理超自然恐怖",
      "publishedAt": "2026-10-16",
      "cover": "https://images.unsplash.com/photo-1786970656287-235ba183282d?auto=format&fit=crop&w=720&q=85",
      "description": "夜班警衛煒被困在德安大樓錯位的電梯與四樓走廊中，必須從每月整理留下的痕跡找出離開的方法。",
      "details": {
        "about": "二十八歲的煒因受騙而急需工作，接下德安大樓的夜班警衛職缺。從電梯提示音、整理紀錄和錯位的樓層開始，他逐步拼出 4104 的異常與大樓試圖掩蓋的過去；結局保留他是否真正離開的可能。",
        "characters": [
          {
            "name": "煒",
            "role": "主角，28 歲夜班警衛",
            "description": "長期失業又遭詐騙，因經濟壓力接受德安大樓的工作。他敏感、自我否定，卻能注意物件、聲音與環境的不一致，並用可重複驗證的痕跡尋找出口。"
          },
          {
            "name": "離職前輩警衛",
            "role": "煒的工作前輩",
            "description": "熟悉大樓正常格局，第一天帶煒巡看樓層並留下辨認異常的參照；交接後便離開大樓。"
          },
          {
            "name": "4104 的惡魔",
            "role": "非人力量",
            "description": "透過模仿聲音、扭曲空間和錯誤指令引導煒，並利用他的孤立感與自我否定。"
          },
          {
            "name": "前任管理員",
            "role": "與第十階段痕跡相關的人物",
            "description": "曾知悉管理方如何處理 4104；他的警告只以物件偏差、不完整聲音等間接方式留下。"
          },
          {
            "name": "十名祭品",
            "role": "大樓過去的死者",
            "description": "不同時期死於 4104 的十名成年人，各自留下與十誡順序相應的痕跡；設定未提供個別姓名。"
          }
        ],
        "timeline": [
          { "chapter": "1", "period": "故事開始前／宿舍", "event": "遭詐騙、急需收入的煒收到夜班警衛面試通知，仍在宿舍做決定，尚未前往大樓。" },
          { "chapter": "2", "period": "第一天／交接", "event": "煒到德安大樓報到，認識正常樓層格局；前輩短暫消失，煒回宿舍後又聽見電梯提示音。" },
          { "chapter": "3", "period": "第二夜至凌晨", "event": "煒記錄電梯異常，聽見管理員聲音的指示，最後搭電梯前往顯示為 11 樓的未知位置。" },
          { "chapter": "4", "period": "未知樓層／四樓異常走廊", "event": "煒在長走廊辨認整理痕跡，拒絕模仿管理員的指令，注意到鏡中唯一打開的 4101。" },
          { "chapter": "5", "period": "4101 套房", "event": "煒進入 4101，遇上未知來電與鏡中門的異常。" },
          { "chapter": "5-1", "period": "4101 套房內", "event": "舊鑰匙成為新的選擇；煒沒有拿走它。" },
          { "chapter": "5-2", "period": "鏡中門後", "event": "煒穿過不存在的入口，失去原本的退路。" },
          { "chapter": "6", "period": "鏡中樓梯間", "event": "煒沿樓梯往下，聽見不同時期留下的求救聲，並在受傷後繼續前進。" },
          { "chapter": "7", "period": "似曾相識的警衛室", "event": "煒回到看似正常的警衛室，監視器與玻璃出口卻互相矛盾。" },
          { "chapter": "8", "period": "入口玻璃另一側", "event": "玻璃映出唯一的門與無臉影子；門後的求救片段將煒引回電梯。" },
          { "chapter": "9", "period": "錯位電梯與房間", "event": "房間重播不明人物的求救片段，煒取得十月整理紀錄，異常開始模仿他的聲音。" },
          { "chapter": "10", "period": "不存在的樓層", "event": "煒用樓層照片尋路，反覆回到錯置空間；值班簿寫著他已離開，監視器卻拍到另一個煒。" },
          { "chapter": "11", "period": "02:16 的值班紀錄", "event": "煒發現不同年代的紀錄反覆出現「已離開大樓」與 02:16，沿平面圖尋找入口。" },
          { "chapter": "12", "period": "雨中的入口與電梯", "event": "雨水映出異常入口與求救聲，煒放棄看似真實的街景，走進有第十一個空位的電梯。" },
          { "chapter": "13", "period": "電梯重演的受騙經歷", "event": "煒再次面對詐騙與補繳保證金的記憶，識破催促並拒絕確認不存在的十一樓。" },
          { "chapter": "14", "period": "被重現的宿舍", "event": "房間重演失業與租約壓力；煒拒絕虛假的保證，回到異常電梯。" },
          { "chapter": "15", "period": "02:16／四樓走廊", "event": "電梯打開，長走廊盡頭出現 4104 門牌。" },
          { "chapter": "16", "period": "進入 4104 後", "event": "煒看見十處經整理的痕跡，第一階段的密閉與偽信仰標記開始重現。" },
          { "chapter": "17", "period": "4104 的鏡面空間", "event": "鏡面抹去面容、錄音失去求救聲；煒記錄痕跡，房間裡的影子轉向他。" },
          { "chapter": "18", "period": "祭品痕跡逐步顯現", "event": "封閉睡眠、家族遺物與倒放影像接連出現，煒承認眼前證據後被困在隔間。" },
          { "chapter": "19", "period": "隔間與舊物", "event": "煒拒絕取用不屬於自己的物件，也拒絕否認影像，找到管理員留下的熄燈警告。" },
          { "chapter": "20", "period": "整理紀錄與電源箱線索", "event": "線索揭露管理方掩蓋十起死亡，並指向前任管理員與四樓電源箱路線。" },
          { "chapter": "21", "period": "四樓停電後", "event": "煒切斷四樓電源，暫停高溫異常並抵達地下一樓；他知道停電不等於逃離。" },
          { "chapter": "22", "period": "由照片指引的返程", "event": "煒依第一天拍下的樓層照片穿過四樓，拒絕惡魔提供的電梯捷徑，回到入口走廊。" },
          { "chapter": "23", "period": "大樓門外／雨中", "event": "煒推門走進雨裡；身體感受像是到了外界，手機影像卻仍將他留在門內。" }
        ]
      },
