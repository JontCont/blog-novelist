    {
      "slug": "gambler",
      "title": "賭徒",
      "genre": "恐怖驚悚",
      "publishedAt": "2026-09-20",
      "cover": "https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=720&q=85",
      "description": "受困高樓頂端的四名少年，必須穿過三段玻璃橋，才能離開這場以人命為注的賭局。",
      "details": {
        "about": "阿佑、阿釘、白鴉與小滿在沒有圍欄的頂樓醒來。想抵達對面大樓，他們必須輪流押上彼此的安全，穿過三段玻璃橋；每次選擇都讓四人更難相信彼此。",
        "characters": [
          {
            "name": "阿佑",
            "role": "主角，17 歲",
            "description": "擅長推算機率，習慣把危機當成賭局處理。表面冷靜，內心害怕失去控制，也必須面對自己把人命化成數字的習慣。"
          },
          {
            "name": "阿釘",
            "role": "同行者，18 歲",
            "description": "嘴硬、愛用玩笑遮掩恐懼；其實有懼高症，最抗拒成為第一個踏上玻璃板的人。"
          },
          {
            "name": "白鴉",
            "role": "同行者，17 歲",
            "description": "寡言、記憶精確且觀察敏銳。她隱瞞自己曾點擊匿名賭局邀請，因此成為眾人懷疑的對象。"
          },
          {
            "name": "小滿",
            "role": "同行者，16 歲",
            "description": "安靜敏感，最早注意到頂樓燈光節奏中的線索；到了關鍵時刻，她比其他人更能下定決心。"
          }
        ],
        "timeline": [
          { "chapter": 1, "period": "未知高樓的頂樓", "event": "四人醒來後面對三段玻璃橋與三道賭局題目；阿佑推理出答案，眾人抵達對面大樓的門，新的倒數卻再次亮起。" }
        ]
      },
