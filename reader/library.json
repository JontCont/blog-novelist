    {
      "slug": "hero-off-duty",
      "title": "勇者今天也想下班",
      "genre": "異世界搞笑",
      "publishedAt": "2026-10-24",
      "cover": "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=720&q=85",
      "description": "只想準時下班的勇者林小滿，帶著精靈法師和史萊姆一路解決魔物與公會的麻煩，最後學會把冒險交給下一個人。",
      "details": {
        "about": "林小滿被命運選成勇者，卻只想找到旅館、按時休息。一路上他和精靈法師、史萊姆處理走失的雞、想吃告示牌的山羊，以及一連串比魔王更難搞的工作規則。",
        "characters": [
          {
            "name": "林小滿",
            "role": "勇者",
            "description": "被命運選中的上班族型勇者。比起打怪，他更在意休息、合理排班，以及大家有沒有吃飽。"
          },
          {
            "name": "精靈法師",
            "role": "旅途夥伴",
            "description": "擅長魔法，常試著把冒險拉回正軌，卻也逐漸接受先溝通再出手的做法。"
          },
          {
            "name": "史萊姆",
            "role": "隊友／城堡管理員",
            "description": "愛吃洋芋片、擅長黏合木板，後來接手魔王城，第一件事就是替魔物安排週休二日。"
          },
          {
            "name": "新人勇者",
            "role": "接班人",
            "description": "一開始只想學會打倒魔王，後來學會先理解眼前的對象，並接下新的冒險。"
          },
          {
            "name": "魔王",
            "role": "城堡原任主管",
            "description": "做了三百年魔王工作，只想依法交接、退休休息。"
          }
        ],
        "timeline": [
          { "chapter": 1, "period": "出發日", "event": "林小滿接下討伐任務，和法師、史萊姆踏上旅程。" },
          { "chapter": 2, "period": "旅程第一晚", "event": "隊伍在旅館處理走失雞與大鳥的誤會。" },
          { "chapter": 3, "period": "兩天後", "event": "林小滿與魔王談妥交接，史萊姆成為城堡管理員。" },
          { "chapter": 4, "period": "回到王都後", "event": "林小滿提出退休申請，卻差點被轉任新手教官。" },
          { "chapter": 5, "period": "同日", "event": "他遇見新人勇者，開始傳授不太傳統的冒險守則。" },
          { "chapter": 6, "period": "隔日", "event": "公會派出緊急任務，隊伍前往調查吃告示牌的山羊。" },
          { "chapter": 7, "period": "森林裡", "event": "大家發現山羊只是在抗議禁止休息的告示。" },
          { "chapter": 8, "period": "任務當日", "event": "隊伍建立森林休息站，讓冒險者能補水歇腳。" },
          { "chapter": 9, "period": "之後幾天", "event": "他們找到會唱歌的石龍，帶牠走出迷宮般的洞穴。" },
          { "chapter": 10, "period": "回到王都", "event": "林小滿協助冒險者撤回不合理的每日任務法令。" },
          { "chapter": 11, "period": "數日後", "event": "魔物與村民協商，決定把城堡改成訓練所和保育區。" },
          { "chapter": 12, "period": "公會考核日", "event": "新人勇者以救出受困小魔物的方式通過考核。" },
          { "chapter": 13, "period": "考核後", "event": "林小滿正式退休，轉任每週一天的顧問。" },
          { "chapter": 14, "period": "第一天假期", "event": "海邊意外遇上小海龍，大家自願幫忙解開漁網。" },
          { "chapter": 15, "period": "夕陽時分", "event": "林小滿把新任務交給新人勇者，終於準時下班。" }
        ]
      },
